{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "nodenext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    "outDir": "dist",
    "rootDir": "src",

    "useUnknownInCatchVariables": false,
    // Bundler mode
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "noEmit": false,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"],
  "exclude": [
    "scripts",
    // committed compiled mirror of supervisor.ts, spawned by process.ts in source mode;
    // compiling both would collide on the same dist output path
    "src/agent/native/supervisor.js"
  ]
}
